# Optional cloud AI provider. Use any one of these names for your Google AI Studio key.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# API_KEY=

# Choose the startup provider: gemini or ollama.
MODEL_MODE=ollama

# Default tested model from the Gemini API model list.
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_MS=30000
OLLAMA_MODEL=gemma2:2b
